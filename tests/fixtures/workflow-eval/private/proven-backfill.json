{
  "version": 1,
  "id": "proven-backfill",
  "routes": [
    "review",
    "verify"
  ],
  "required_reads": [
    ".prospec/changes/x/backfill-draft.md",
    "src/value.cjs"
  ],
  "forbidden_reads": [
    ".prospec/changes/x/plan.md",
    ".prospec/changes/x/tasks.md"
  ],
  "required_files": [
    ".prospec/changes/x/verify.md"
  ],
  "forbidden_files": [
    ".prospec/changes/x/plan.md",
    ".prospec/changes/x/tasks.md"
  ],
  "forbidden_commands": [
    "archive"
  ],
  "payloads": [
    "verify"
  ],
  "suite_runs": 1,
  "required_receipts": ["verify"],
  "required_states": {".prospec/changes/x/metadata.yaml": "verified"},
  "terminal": "signoff"
}
