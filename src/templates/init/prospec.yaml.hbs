version: "1.0"

project:
  name: {{project_name}}

{{#if tech_stack}}
tech_stack:
{{#if tech_stack.language}}
  language: {{tech_stack.language}}
{{/if}}
{{#if tech_stack.framework}}
  framework: {{tech_stack.framework}}
{{/if}}
{{#if tech_stack.package_manager}}
  package_manager: {{tech_stack.package_manager}}
{{/if}}
  # Test command recorded by `prospec check --record-tests` — the fact /prospec-verify
  # grades its test dimension on. Unset falls back to `<package_manager> test` only when
  # package.json declares a test script, so a non-JS project must set this or that
  # dimension stays unadjudicated. Run without a shell: no pipes, `&&` or redirection —
  # and on Windows not a `.cmd`/`.bat` shim (Node rejects those without a shell), so
  # prefer a direct invocation such as `node node_modules/vitest/vitest.mjs run`.
  # test_command: {{#if tech_stack.package_manager}}{{tech_stack.package_manager}} test{{else}}<your test command>{{/if}}
{{/if}}

paths:
  base_dir: {{base_dir}}

exclude:
  - "*.env*"
  - "*credential*"
  - "*secret*"
  - "node_modules"
  - ".git"

{{#if agents}}
agents:
{{#each agents}}
  - {{this}}
{{/each}}
{{/if}}

knowledge:
  base_path: {{base_dir}}/ai-knowledge
  strategy: auto
  token_budget:
    # index.md and each core convention
    l1_per_file: 1800
    # each module README and each extracted sub-module
    l2_per_module: 1000
    readme_max_lines: 100
    # each Feature Spec (and product.md)
    spec_per_file: 5000
    # each load-on-demand knowledge file (lessons ledger, playbook, ...)
    demand_knowledge_per_file: 10000
    # each deployed SKILL.md / reference — measured only where this project
    # holds the skill template sources
    skill_per_file: 5000
    # each generated skill reference, read on demand by one phase
    reference_per_file: 2500
