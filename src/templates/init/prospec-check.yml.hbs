# Prospec deterministic drift gate — zero LLM, zero tokens.
# Supply-chain hardening is the default here:
#   - every third-party action is pinned to a full commit SHA (tag re-point immunity)
#   - permissions are read-only: a pull request from a fork only ever gets a read-only
#     token, so this workflow posts no comment — prospec-check-comment.yml does, from
#     the report artifact this run uploads
name: Prospec Check

on:
  push:
    branches:
      - main
  pull_request:

permissions:
  contents: read

jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
        with:
          # Full history — knowledge-health reports each module's commit times, which a
          # shallow clone leaves null; freshness itself is judged by source content digest.
          fetch-depth: 0
{{#if use_pnpm}}
      - uses: pnpm/action-setup@0e279bb959325dab635dd2c09392533439d90093 # v6.0.8
{{/if}}
      - uses: actions/setup-node@48b55a011bda9f5d6aeb4c2d9c7362e8dae4041e # v6.4.0
        with:
          node-version: 22
{{#if use_pnpm}}
          cache: pnpm
{{/if}}
      - run: {{install_cmd}}
      - name: Run prospec check (strict gate)
        # explicit bash turns on pipefail — without it, tee's exit 0 would mask the gate
        shell: bash
        run: {{check_cmd}} | tee prospec-check-output.txt
      - name: Record the pull request number
        if: always() && github.event_name == 'pull_request'
        env:
          PR_NUMBER: $\{{ github.event.pull_request.number }}
        run: echo "$PR_NUMBER" > pr-number.txt
      - name: Upload drift report
        if: always()
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: prospec-report
          path: |
            prospec-report.json
            prospec-check-output.txt
            pr-number.txt
          if-no-files-found: ignore
