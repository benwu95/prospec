# Complete .prospec.yaml reference — every field prospec reads, with an example
# value and a note. Emitted by `prospec config example`. Copy the fields you need
# into your project's .prospec.yaml; all fields except `project.name` are optional
# and fall back to the defaults noted below.

# The prospec version the project last upgraded to. Stamped by `prospec init`,
# refreshed by `prospec upgrade`. A legacy `version: "1.0"` is treated as stale.
version: "1.0"

project:
  # Project name (the only REQUIRED field).
  name: my-project

# Overrides auto-detected tech stack (reported with `Source: config`).
tech_stack:
  language: typescript
  framework: none
  package_manager: pnpm
  # Test command recorded by `prospec check --record-tests` (the fact verify's test
  # dimension is graded on). Unset falls back to `<package_manager> test` when
  # package.json declares a test script. Run WITHOUT a shell — argv-tokenized, so
  # pipes / `&&` / redirection are not supported.
  #
  # ON WINDOWS this must not be a `.cmd`/`.bat` shim: Node refuses to spawn one
  # without a shell (CVE-2024-27980), even via an absolute path. `pnpm test` is such
  # a shim, so name a shell-free invocation instead — the check reports an honest
  # skip (never a FAIL you cannot fix) and tells you this when it detects one.
  # The example below is one such shell-free, shim-free invocation (Node's builtin
  # runner); on POSIX-only projects `pnpm test` also works.
  test_command: node --test

paths:
  # Root of the prospec artifact tree (Constitution, index.md, specs, knowledge).
  # Defaults to `prospec`.
  base_dir: prospec

# Glob patterns excluded from AI-knowledge scanning.
exclude:
  - "*.env*"
  - "*credential*"
  - "*secret*"
  - node_modules
  - .git

# AI agent configs to generate. Valid: claude, codex, copilot, antigravity.
agents:
  - claude

knowledge:
  # Knowledge base location. Defaults to `{base_dir}/ai-knowledge`.
  base_path: prospec/ai-knowledge
  # List of repository-root-relative, posix-formatted paths to generated artifacts.
  # These files are exempt from knowledge staleness checks (they don't move last_src_commit).
  generated_artifacts:
    - dist/bundle.js
  # Extra convention files to pre-load as L1 Core Conventions, relative to the
  # ai-knowledge/ directory.
  additional_core_conventions:
    - my-custom-api-rules.md
  # Module-partitioning strategy. Valid: auto, architecture, domain, package.
  strategy: auto
  # Per-file size limits for the knowledge-size drift check, one per load surface.
  # Set only the fields you want to change; anything unset falls back to the
  # default shown here. Over-budget files WARN — a pressure signal, never a build
  # breaker — and each finding names the convergence path for its surface.
  token_budget:
    # L1 — index.md and each core convention
    l1_per_file: 1800
    # L2 — each module README and each extracted sub-module
    l2_per_module: 1000
    readme_max_lines: 100
    # each Feature Spec (and product.md); slice an over-budget spec under
    # specs/features/{feature}/ — slices are measured against this same budget
    spec_per_file: 5000
    # each load-on-demand knowledge file (lessons ledger, playbook, ...). Kept
    # separate from l1_per_file on purpose: a file read in slices has no business
    # being graded against the budget of a document read whole
    demand_knowledge_per_file: 10000
    # each deployed SKILL.md / reference. Measured only where the project holds
    # the skill template sources — a project that merely consumes generated skills
    # cannot act on such a finding, so it is not given one
    skill_per_file: 5000
    # each generated skill reference, read on demand by one phase
    reference_per_file: 2500
    # ratio of the budget at which the pressure signal triggers (0.85 = 85%)
    headroom: 0.85

# Language for AI-generated change artifacts (and their archived summaries under
# specs/_archived-history/). Code, identifiers, technical terms and commit messages
# always stay English; the trust zone follows `trust_zone_language` below. The
# Language Policy rule seeded into CONSTITUTION.md and the entry config's declaration
# are generated from the same path sets and languages, and `prospec check`'s
# `language-policy-drift` warns when the Constitution's Description drifts from them.
# Defaults to English when absent.
artifact_language: Traditional Chinese (Taiwan)

# Language of the trust zone (the AI Knowledge base, specs/features/, specs/product.md,
# index.md, README.md, CONSTITUTION.md). Defaults to English when absent — the
# behavior every project had before this key existed. `prospec init` asks for it only
# when `artifact_language` is non-English (defaulting to that language); pass
# `--trust-zone-language` to skip the prompt. Set it to the same value as
# `artifact_language` for a project whose whole documentation set is one language;
# code, identifiers, technical terms and commit messages stay English regardless.
trust_zone_language: English

# Executor label vocabulary (optional). When declared, `prospec verify record --executor`
# and `prospec check --record-review --executor` refuse a label outside this list, so
# the labels `prospec learn stats` later groups archived metadata by are the ones
# written here. The labels are yours: prospec attaches no meaning to them and knows
# no model. Absent: any non-empty string is accepted (the behavior before this key
# existed).
executors:
  - judge
  - drafter

# Feedback promotion (`prospec learn`) — both blocks optional; the defaults are shown.
learn:
  thresholds:                       # `prospec learn upsert` promotion rule
    frequency: 3                    # suggest promote when frequency >= this ...
    impact_modules: 2               # ... AND |impact_modules| >= this
  lens_thresholds:                  # `prospec learn yield` retirement recommendations
    consecutive_zero_threshold: 5   # zero-yield changes in a row before `retire`
    min_invocations: 3              # declared runs (`--lenses`) required before any recommendation
    min_yield: 0.1                  # yield_ratio below this recommends `review`

# Native-language activation keywords per skill (skill-name -> list of strings),
# merged onto each skill's English trigger baseline. Run `prospec agent triggers`
# to get a ready-to-translate scaffold of the skills still missing an entry.
skill_triggers:
  prospec-explore:
    - explore
    - 探索
