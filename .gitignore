# Dependencies
node_modules/

# Build output
dist/

# npm lockfile (this project is pnpm-only for development)
package-lock.json

# Coverage
coverage/
# vitest JSON report — the count contract's input, regenerated by `pnpm test:coverage`
vitest-report.json

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Environment
.env*
!.env.example

# Logs
*.log

# Temp files
*.tmp
*.swp

# Task scratch (per-branch todo / lessons)
.tasks/

# Agents — track the release/submit-pr/submit-issue maintainer skills; ignore the rest
# (prospec-* skills are re-included by the prospec block at the end).
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/release/
!.claude/skills/submit-pr/
!.claude/skills/submit-issue/
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/release/
!.agents/skills/submit-pr/
!.agents/skills/submit-issue/

# Prospec (.prospec/ and prospec-report.json are ignored by the prospec block at the end)
measurement-report*.json
escaped-defect-report.json

# Stryker sandboxes — full repo copies; an interrupted run leaves them behind,
# and computeChangeDigest hashes every untracked file it finds
.stryker-tmp/
# ...and its report output, written by the html/json reporters
reports/
# prospec:auto-start
/.prospec/*
/prospec-report.json
!/.claude/skills/prospec-*/
!/.claude/skills/prospec-*/references/
!/.claude/skills/prospec-*/*.md
!/.claude/skills/prospec-*/references/*.md
!/.agents/skills/prospec-*/
!/.agents/skills/prospec-*/references/
!/.agents/skills/prospec-*/*.md
!/.agents/skills/prospec-*/references/*.md
# prospec:auto-end
